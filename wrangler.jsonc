{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wfc-space-worker",
  "main": "worker/room.ts",
  "compatibility_date": "2026-01-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "Room",
        "class_name": "Room"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room"]
    }
  ]
}
